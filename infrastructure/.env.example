# ============================================================================
# DeepAgents Control Platform - Local Development Environment
# ============================================================================
#
# Copy this file to .env and fill in actual values:
#   cp .env.example .env
#
# Then start services with:
#   docker-compose up -d
#
# ============================================================================

# PostgreSQL Configuration
# Generate a strong password with: openssl rand -hex 16
POSTGRES_DB=deepagents_platform
POSTGRES_USER=deepagents
POSTGRES_PASSWORD=your_secure_password_here_min_16_chars
